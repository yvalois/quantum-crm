# syntax=docker/dockerfile:1.7
ARG NODE_IMAGE=node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate
COPY . .
RUN pnpm install --frozen-lockfile --prod=false \
    && pnpm --filter "@quantum-crm/database..." build \
    && pnpm deploy --filter "@quantum-crm/database" --prod /runtime

FROM ${NODE_IMAGE}
ENV NODE_ENV=production
WORKDIR /workspace
COPY --from=build --chown=node:node /runtime ./
RUN apk del --no-network apk-tools zlib \
    && node --version \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
USER node
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy --config ./prisma/crm/prisma7.config.ts"]
