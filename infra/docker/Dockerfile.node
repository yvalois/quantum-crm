# syntax=docker/dockerfile:1.7

ARG NODE_TOOLCHAIN_IMAGE=node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
ARG NODE_RUNTIME_IMAGE=node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_TOOLCHAIN_IMAGE} AS toolchain
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate

FROM toolchain AS build
ARG APP
WORKDIR /workspace
COPY . .
RUN case "${APP}" in api|admin-api|worker|deploy-executor|deploy-host|agent-runtime) ;; *) exit 64 ;; esac \
    && pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/${APP}..." build \
    && pnpm --filter "@quantum-crm/${APP}" deploy --prod /runtime

FROM ${NODE_RUNTIME_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /runtime ./
RUN apk del --no-network apk-tools zlib \
    && node --version \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
USER node
CMD ["node", "dist/main.js"]
