# syntax=docker/dockerfile:1.7

ARG NODE_TOOLCHAIN_IMAGE=node:24.21.0-trixie@sha256:be40f6a87b9b22215ddb20da0a2320a5c6d583fe3ee3b0024d9fa4f05b40c8fd
ARG NODE_RUNTIME_IMAGE=node:24.21.0-trixie-slim@sha256:8ec5d7557396cfe32d21c3f9c13072355ceab22b584578ca4bb28af31120cffe

FROM ${NODE_TOOLCHAIN_IMAGE} AS toolchain
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate

FROM toolchain AS build
ARG APP
WORKDIR /workspace
COPY . .
RUN case "${APP}" in api|admin-api|worker|deploy-executor|deploy-host|agent-runtime) ;; *) exit 64 ;; esac \
    && pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/${APP}..." build \
    && pnpm --filter "@quantum-crm/${APP}" deploy --prod /runtime

FROM ${NODE_RUNTIME_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /runtime ./
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
USER node
CMD ["node", "dist/main.js"]
