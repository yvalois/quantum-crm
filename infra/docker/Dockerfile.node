# syntax=docker/dockerfile:1.7

ARG NODE_TOOLCHAIN_IMAGE=node:24.21.0-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4
ARG NODE_RUNTIME_IMAGE=node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

FROM ${NODE_TOOLCHAIN_IMAGE} AS toolchain
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate

FROM toolchain AS build
ARG APP
WORKDIR /workspace
COPY . .
RUN case "${APP}" in api|admin-api|worker|deploy-executor|agent-runtime) ;; *) exit 64 ;; esac \
    && pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/${APP}..." build \
    && pnpm --filter "@quantum-crm/${APP}" deploy --prod /runtime

FROM ${NODE_RUNTIME_IMAGE} AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /runtime ./
USER node
CMD ["node", "dist/main.js"]
