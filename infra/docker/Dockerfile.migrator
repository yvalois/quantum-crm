# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.21.0-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4

FROM ${NODE_IMAGE} AS runtime
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate
COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/database..." build
ENV NODE_ENV=production
USER node
CMD ["sh", "-c", "./packages/database/node_modules/.bin/prisma migrate deploy --config packages/database/prisma/platform/prisma7.config.ts && node packages/database/dist/grant-platform-runtime.js"]
