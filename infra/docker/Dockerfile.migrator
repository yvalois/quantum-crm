# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS runtime
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate
COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/database..." build \
    && apk add --no-cache openssl \
    && apk del --no-network apk-tools zlib \
    && node --version \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
ENV NODE_ENV=production
USER node
CMD ["sh", "-c", "./packages/database/node_modules/.bin/prisma migrate deploy --config packages/database/prisma/platform/prisma7.config.ts && node packages/database/dist/grant-platform-runtime.js"]
