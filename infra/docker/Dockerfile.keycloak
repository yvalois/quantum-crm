# syntax=docker/dockerfile:1.7

ARG KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4@sha256:82a77884f3af238beab1e7afd63b5f530e1b5c0590bd7aa60b40a40463e29b2c
ARG MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21-noble@sha256:2fa8b35172589aafa259fe953f4829859169bb0516f28f2b5a027c7c52017bee
ARG RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine@sha256:51ab5e3302e7141ce665ca3ea85e8b5cd648eafbc3c0c90dd79d6537684e4555

FROM ${MAVEN_IMAGE} AS activation-provider
WORKDIR /workspace
COPY infra/keycloak/activation-provider/pom.xml ./pom.xml
COPY infra/keycloak/activation-provider/src ./src
RUN mvn --batch-mode --no-transfer-progress -DskipTests package

FROM ${MAVEN_IMAGE} AS security-overrides
RUN mvn --batch-mode --no-transfer-progress org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy \
      -Dartifact=io.netty:netty-handler:4.1.137.Final -DoutputDirectory=/overrides \
    && mvn --batch-mode --no-transfer-progress org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy \
      -Dartifact=org.bouncycastle:bcprov-jdk18on:1.85 -DoutputDirectory=/overrides \
    && mvn --batch-mode --no-transfer-progress org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy \
      -Dartifact=com.fasterxml.jackson.core:jackson-databind:2.21.7 -DoutputDirectory=/overrides

FROM ${KEYCLOAK_IMAGE} AS builder
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_HTTP_MANAGEMENT_HEALTH_ENABLED=true
COPY --from=activation-provider /workspace/target/quantum-activation-provider.jar /opt/keycloak/providers/quantum-activation-provider.jar
COPY --from=security-overrides /overrides/ /opt/qcrm-security-overrides/
RUN netty_files="$(find /opt/keycloak -type f -name 'io.netty.netty-handler-*.jar' ! -name '*-proxy-*' -print)" \
    && test -n "$netty_files" \
    && for file in $netty_files; do \
         install -m 0644 /opt/qcrm-security-overrides/netty-handler-4.1.137.Final.jar "$file"; \
       done \
    && bcprov_files="$(find /opt/keycloak -type f -name '*bcprov-jdk18on-*.jar')" \
    && test -n "$bcprov_files" \
    && for file in $bcprov_files; do \
         install -m 0644 /opt/qcrm-security-overrides/bcprov-jdk18on-1.85.jar "$file"; \
       done \
    && jackson_databind_files="$(find /opt/keycloak/lib -type f -name 'com.fasterxml.jackson.core.jackson-databind-*.jar')" \
    && test -n "$jackson_databind_files" \
    && for file in $jackson_databind_files; do \
         install -m 0644 /opt/qcrm-security-overrides/jackson-databind-2.21.7.jar "$file"; \
       done
RUN /opt/keycloak/bin/kc.sh build
RUN for metadata in \
      /opt/keycloak/lib/quarkus/quarkus-application.dat \
      /opt/keycloak/lib/lib/deployment/deployment-class-path.dat \
      /opt/keycloak/lib/lib/deployment/appmodel.dat; do \
      sed -i \
        -e 's/io.netty.netty-handler-4.1.136.Final.jar/io.netty.netty-handler-4.1.137.Final.jar/g' \
        -e 's/org.bouncycastle.bcprov-jdk18on-1.84.jar/org.bouncycastle.bcprov-jdk18on-1.85.jar/g' \
        -e 's/com.fasterxml.jackson.core.jackson-databind-2.21.5.jar/com.fasterxml.jackson.core.jackson-databind-2.21.7.jar/g' \
        "$metadata"; \
    done \
    && netty_files="$(find /opt/keycloak -type f -name 'io.netty.netty-handler-4.1.136.Final.jar')" \
    && for file in $netty_files; do mv "$file" "${file%4.1.136.Final.jar}4.1.137.Final.jar"; done \
    && bcprov_files="$(find /opt/keycloak -type f -name '*bcprov-jdk18on-1.84.jar')" \
    && for file in $bcprov_files; do mv "$file" "${file%1.84.jar}1.85.jar"; done \
    && jackson_databind_files="$(find /opt/keycloak/lib -type f -name 'com.fasterxml.jackson.core.jackson-databind-2.21.5.jar')" \
    && for file in $jackson_databind_files; do mv "$file" "${file%2.21.5.jar}2.21.7.jar"; done \
    && rm -rf /opt/keycloak/bin/client \
    && rm -f /opt/keycloak/bin/kcadm.sh /opt/keycloak/bin/kcreg.sh

FROM ${RUNTIME_IMAGE}
RUN apk add --no-cache bash \
    && addgroup -S -g 1000 keycloak-runtime \
    && adduser -S -D -H -u 1000 -G keycloak-runtime keycloak-runtime
COPY --from=builder --chown=1000:1000 /opt/keycloak/ /opt/keycloak/
COPY --chmod=0444 infra/keycloak/quantum-platform-realm.json /opt/keycloak/data/import/quantum-platform-realm.json
COPY --chmod=0555 infra/keycloak/platform-entrypoint.sh /opt/keycloak/bin/qcrm-platform-entrypoint
COPY --chmod=0555 infra/keycloak/bootstrap-provisioner.sh /opt/keycloak/bin/qcrm-bootstrap-provisioner
RUN chmod 0555 /opt/keycloak/data /opt/keycloak/data/import \
    && chown -R 1000:1000 /opt/keycloak \
    && apk del --no-network apk-tools zlib fontconfig ttf-dejavu gnupg
USER 1000:1000
ENTRYPOINT ["/opt/keycloak/bin/qcrm-platform-entrypoint"]
CMD ["start", "--optimized", "--import-realm"]
