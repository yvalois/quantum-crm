# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.21.0-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

FROM ${NODE_IMAGE} AS toolchain
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate

FROM toolchain AS build
ARG APP
WORKDIR /workspace
COPY . .
RUN case "${APP}" in crm-web|portal-web|admin-web) ;; *) exit 64 ;; esac \
    && pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/${APP}..." build

FROM ${NODE_IMAGE} AS runtime
ARG APP
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /workspace/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /workspace/apps/${APP}/.next/static ./apps/${APP}/.next/static
RUN ln -s "apps/${APP}" runtime
USER node
EXPOSE 3000
CMD ["node", "runtime/server.js"]
