# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1

FROM ${NODE_IMAGE} AS toolchain
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
RUN corepack enable && corepack prepare pnpm@9.13.2 --activate

FROM toolchain AS build
ARG APP
WORKDIR /workspace
COPY . .
RUN case "${APP}" in crm-web|portal-web|admin-web) ;; *) exit 64 ;; esac \
    && pnpm install --frozen-lockfile \
    && pnpm --filter "@quantum-crm/${APP}..." build

FROM ${NODE_IMAGE} AS runtime
ARG APP
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /workspace/apps/${APP}/.next/standalone ./
COPY --from=build --chown=node:node /workspace/apps/${APP}/.next/static ./apps/${APP}/.next/static
RUN ln -s "apps/${APP}" runtime
RUN apk del --no-network apk-tools zlib \
    && node --version \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/pnpm /usr/local/bin/pnpx /usr/local/bin/yarn /usr/local/bin/yarnpkg
USER node
EXPOSE 3000
CMD ["node", "runtime/server.js"]
