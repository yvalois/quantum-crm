{
	# Solo el proceso deploy-host usa este endpoint desde dentro del contenedor
	# mediante una operacion fija de Docker. No se publica en el host ni en una red.
	admin 127.0.0.1:2019
}

(static_headers) {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}
}

(admin_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		-Server
	}
}

{$QCRM_QUANTUM_SITE_HOST} {
	import static_headers
	root * /srv/quantum
	try_files {path} {path}/ /index.html
	file_server
}

{$QCRM_MR_BUSINESS_SITE_HOST} {
	import static_headers
	root * /srv/mr-business
	try_files {path} {path}/ /index.html
	file_server
}

{$QCRM_ADMIN_HOST} {
	import admin_headers
	# GitHub Actions publica candidatas mediante el principal OIDC dedicado.
	# Solo se expone la ruta exacta de alta; las demas rutas de admin-api
	# permanecen en la red interna y siguen protegidas por sus propias guardas.
	@release_candidate path /api/v1/release-candidates
	handle @release_candidate {
		reverse_proxy admin-api:3002 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}
	reverse_proxy admin-web:3000 {
		health_uri /api/health/ready
		health_interval 10s
		health_timeout 3s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

{$QCRM_IDENTITY_HOST} {
	import admin_headers
	# La emision de activaciones es una frontera autenticada entre el API CRM y
	# Keycloak. El proveedor valida el bearer contra el cliente bootstrap y no
	# expone datos ni enlaces sin esa credencial.
	@internal_activation path /realms/*/qcrm-internal/*
	handle @internal_activation {
		reverse_proxy platform-keycloak:8080
	}
	reverse_proxy platform-keycloak:8080 {
		health_uri /realms/quantum-platform/.well-known/openid-configuration
		health_interval 15s
		health_timeout 5s
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

# Frontera S3 pública limitada a operaciones de datos previamente firmadas.
# Los endpoints administrativos de SeaweedFS permanecen en la red privada.
{$QCRM_STORAGE_HOST} {
	import static_headers

	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, HEAD, POST"
		header Access-Control-Allow-Headers "Content-Type, X-Amz-Algorithm, X-Amz-Credential, X-Amz-Date, X-Amz-Meta-Qcrm-Sha256, X-Amz-Signature"
		header Access-Control-Max-Age "600"
		respond "" 204
	}

	@object_data method GET HEAD POST
	handle @object_data {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Expose-Headers "ETag, X-Amz-Version-Id"
		reverse_proxy platform-storage:8333 {
			transport http {
				dial_timeout 3s
				response_header_timeout 60s
			}
		}
	}

	respond "Method Not Allowed" 405
}

# Solo admin-api alcanza este nombre por una red Docker interna dedicada. El
# handler acepta exactamente el JWKS de GitHub Actions y Caddy fija el destino,
# Host y SNI; ninguna solicitud controla una URL, host o path de salida.
http://github-actions-oidc:8081 {

	@github_actions_jwks path /.well-known/jwks
	handle @github_actions_jwks {
		reverse_proxy https://token.actions.githubusercontent.com {
			header_up Host token.actions.githubusercontent.com
			transport http {
				tls_server_name token.actions.githubusercontent.com
				dial_timeout 3s
				response_header_timeout 5s
			}
		}
	}

	respond "Not Found" 404
}

# El glob vacio es valido. deploy-host genera exclusivamente bloques por UUID
# en este directorio montado de solo lectura y recarga el conjunto completo.
import tenant-routes/*.caddy
