# Compatibilidad temporal para enlaces emitidos antes de migrar el issuer OIDC.
# Las nuevas URLs se generan con QCRM_IDENTITY_HOST en el Caddyfile principal.
identity.2-25-172-119.nip.io {
	import admin_headers
	@internal_activation path /realms/*/qcrm-internal/*
	handle @internal_activation {
		reverse_proxy platform-keycloak:8080
	}
	reverse_proxy platform-keycloak:8080 {
		transport http {
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
