# Configuracion local no secreta para admin-api.
# La URL PostgreSQL permanece en el archivo secret referenciado.
QCRM_ENV=local
QCRM_HOST=0.0.0.0
QCRM_PORT=3002
QCRM_SHUTDOWN_TIMEOUT_MS=10000
QCRM_DATABASE_URL_FILE=/run/secrets/qcrm_database_url
QCRM_OIDC_ISSUER=http://keycloak:8080/realms/quantum-platform
QCRM_OIDC_AUDIENCE=quantum-admin-api
QCRM_OIDC_REQUIRED_ACR=2
QCRM_OIDC_MAX_TOKEN_AGE_SECONDS=300
QCRM_GITHUB_ACTIONS_OIDC_AUDIENCE=quantum-release-publisher
QCRM_GITHUB_ACTIONS_REPOSITORY=example/quantum-crm
QCRM_GITHUB_ACTIONS_REPOSITORY_ID=1
QCRM_GITHUB_ACTIONS_REPOSITORY_OWNER_ID=1
