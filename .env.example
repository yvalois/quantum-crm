# Valores locales no secretos para el proceso worker de ejemplo.
# El archivo referenciado contiene una URL sintetica y permanece fuera de Git.
# Preview, staging y produccion deben usar exactamente /run/secrets/qcrm_database_url.
QCRM_ENV=local
QCRM_HOST=127.0.0.1
QCRM_PORT=3101
QCRM_SHUTDOWN_TIMEOUT_MS=10000
QCRM_TENANT_ID=00000000-0000-4000-8000-000000000001
QCRM_DATABASE_URL_FILE=/run/secrets/qcrm_database_url
