# Valores locales no secretos para el proceso worker de ejemplo.
# El archivo referenciado contiene una URL sintetica y permanece fuera de Git.
# Preview, staging y produccion deben usar exactamente /run/secrets/qcrm_database_url.
QCRM_ENV=local
QCRM_HOST=127.0.0.1
QCRM_PORT=3101
QCRM_SHUTDOWN_TIMEOUT_MS=10000
QCRM_TENANT_ID=00000000-0000-4000-8000-000000000001
QCRM_DATABASE_URL_FILE=/run/secrets/qcrm_database_url
QCRM_FILES_S3_ENDPOINT=http://platform-storage:8333
QCRM_FILES_S3_REGION=us-east-1
QCRM_FILES_INCOMING_BUCKET=qcrm-00000000000040008000000000000001-incoming
QCRM_FILES_OBJECTS_BUCKET=qcrm-00000000000040008000000000000001-objects
QCRM_FILES_S3_REQUEST_TIMEOUT_MS=10000
QCRM_FILES_S3_PROCESSOR_ACCESS_KEY_FILE=/run/secrets/qcrm_files_s3_processor_access_key
QCRM_FILES_S3_PROCESSOR_SECRET_KEY_FILE=/run/secrets/qcrm_files_s3_processor_secret_key
QCRM_FILES_CLAMAV_HOST=platform-clamav
QCRM_FILES_CLAMAV_PORT=3310
QCRM_FILES_CLAMAV_TIMEOUT_MS=30000
QCRM_FILES_CLAMAV_MAX_SIGNATURE_AGE_SECONDS=172800
QCRM_FILES_WORKER_POLL_INTERVAL_MS=2000
QCRM_FILES_WORKER_LEASE_SECONDS=300
