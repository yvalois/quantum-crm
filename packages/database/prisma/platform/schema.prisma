generator client {
  provider     = "prisma-client"
  output       = "../../generated/platform"
  runtime      = "nodejs"
  moduleFormat = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["infrastructure", "operations", "platform_iam", "releases", "tenants"]
}

enum PlatformReleaseStatus {
  CANDIDATE @map("candidate")
  VALIDATED @map("validated")
  RETIRED   @map("retired")

  @@map("release_status")
  @@schema("releases")
}

enum PlatformReleaseArtifactName {
  CRM_WEB         @map("crm-web")
  PORTAL_WEB      @map("portal-web")
  ADMIN_WEB       @map("admin-web")
  API             @map("api")
  ADMIN_API       @map("admin-api")
  WORKER          @map("worker")
  DEPLOY_EXECUTOR @map("deploy-executor")
  CRM_MIGRATOR    @map("crm-migrator")
  PLATFORM_KEYCLOAK @map("platform-keycloak")
  AGENT_RUNTIME   @map("agent-runtime")

  @@map("release_artifact_name")
  @@schema("releases")
}

model PlatformRelease {
  id                        String                @id @db.Uuid
  semanticVersion           String                @unique(map: "releases_semantic_version_key") @map("semantic_version") @db.VarChar(80)
  commitSha                 String                @unique(map: "releases_commit_sha_key") @map("commit_sha") @db.Char(40)
  status                    PlatformReleaseStatus @default(CANDIDATE)
  releaseNotes              String                @map("release_notes") @db.Text
  configurationSchemaVersion Int                  @map("configuration_schema_version")
  agentContractVersion      String                @map("agent_contract_version") @db.VarChar(80)
  databaseMigrationRequired Boolean               @map("database_migration_required")
  minimumSourceVersion      String?               @map("minimum_source_version") @db.VarChar(80)
  legacyArtifactCatalog     Boolean               @default(false) @map("legacy_artifact_catalog")
  version                   BigInt                @default(1)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  artifacts                 PlatformReleaseArtifact[]
  tenantProfiles            TenantProfile[]
  capacityReservations      InfrastructureCapacityReservation[]
  provisioningOperations    ProvisioningOperation[]
  tenantConfigurations      TenantConfiguration[]
  tenantContainers          TenantContainer[]
  tenantHttpsRoutes         TenantHttpsRoute[]
  foundationPromotions      PlatformFoundationPromotion[]
  tenantReleasePromotionsPrevious TenantReleasePromotion[] @relation("TenantReleasePromotionPreviousRelease")
  tenantReleasePromotionsTarget   TenantReleasePromotion[] @relation("TenantReleasePromotionTargetRelease")

  @@index([status, createdAt, id], map: "releases_status_created_id_idx")
  @@map("releases")
  @@schema("releases")
}

model PlatformReleaseArtifact {
  releaseId String                      @map("release_id") @db.Uuid
  name      PlatformReleaseArtifactName
  digest    String                      @db.Char(71)
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  release   PlatformRelease             @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([releaseId, name], map: "release_artifacts_pkey")
  @@index([digest], map: "release_artifacts_digest_idx")
  @@map("release_artifacts")
  @@schema("releases")
}

enum InfrastructureServerStatus {
  AVAILABLE   @map("available")
  DRAINING    @map("draining")
  UNAVAILABLE @map("unavailable")

  @@map("server_status")
  @@schema("infrastructure")
}

enum InfrastructureServerArchitecture {
  X86_64 @map("x86_64")
  ARM64   @map("arm64")

  @@map("server_architecture")
  @@schema("infrastructure")
}

model InfrastructureServer {
  id                     String                           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                   String                           @unique(map: "infrastructure_servers_code_key") @db.Citext
  displayName            String                           @map("display_name") @db.Text
  provider               String                           @db.Text
  region                 String                           @db.Text
  publicIpv4             String                           @unique(map: "infrastructure_servers_public_ipv4_key") @map("public_ipv4") @db.Inet
  operatingSystem        String                           @map("operating_system") @db.Text
  architecture           InfrastructureServerArchitecture
  status                 InfrastructureServerStatus
  totalCpuMillicores     Int                              @map("total_cpu_millicores")
  totalMemoryMib         Int                              @map("total_memory_mib")
  totalStorageMib        Int                              @map("total_storage_mib")
  reservedCpuMillicores  Int                              @default(0) @map("reserved_cpu_millicores")
  reservedMemoryMib      Int                              @default(0) @map("reserved_memory_mib")
  reservedStorageMib     Int                              @default(0) @map("reserved_storage_mib")
  operationCredentialRef String                           @map("operation_credential_ref") @db.VarChar(263)
  confirmedAt            DateTime                         @map("confirmed_at") @db.Timestamptz(6)
  version                BigInt                           @default(1)
  createdAt              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  capacityReservations   InfrastructureCapacityReservation[]
  provisioningOperations ProvisioningOperation[]
  tenantDatabases        TenantDatabase[]
  tenantStorage           TenantStorage[]
  tenantConfigurations    TenantConfiguration[]
  tenantContainers         TenantContainer[]
  tenantHttpsRoutes        TenantHttpsRoute[]

  @@index([status, createdAt, id], map: "infrastructure_servers_status_created_id_idx")
  @@map("servers")
  @@schema("infrastructure")
}

enum InfrastructureCapacityReservationStatus {
  RESERVED @map("reserved")
  ACTIVE   @map("active")
  RELEASED @map("released")

  @@map("capacity_reservation_status")
  @@schema("infrastructure")
}

model InfrastructureCapacityReservation {
  id                 String                                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId    String                                  @map("tenant_profile_id") @db.Uuid
  serverId           String                                  @map("server_id") @db.Uuid
  releaseId          String                                  @map("release_id") @db.Uuid
  status             InfrastructureCapacityReservationStatus @default(RESERVED)
  cpuMillicores      Int                                     @map("cpu_millicores")
  memoryMib          Int                                     @map("memory_mib")
  storageMib         Int                                     @map("storage_mib")
  createdAt          DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile      TenantProfile                           @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  server             InfrastructureServer                    @relation(fields: [serverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release            PlatformRelease                         @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provisioningOperations ProvisioningOperation[]

  @@unique([tenantProfileId], map: "capacity_reservations_one_open_per_tenant_idx", where: raw("\"status\" IN ('reserved', 'active')"))
  @@index([serverId, status, createdAt, id], map: "capacity_reservations_server_status_created_id_idx")
  @@map("capacity_reservations")
  @@schema("infrastructure")
}

enum PlatformOperatorStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("operator_status")
  @@schema("platform_iam")
}

enum PlatformPermission {
  TENANTS_READ         @map("tenants:read")
  TENANTS_MANAGE       @map("tenants:manage")
  CONFIGURATION_READ   @map("configuration:read")
  CONFIGURATION_MANAGE @map("configuration:manage")
  DEPLOYMENTS_READ     @map("deployments:read")
  DEPLOYMENTS_EXECUTE  @map("deployments:execute")
  DEPLOYMENTS_ACTIVATE @map("deployments:activate")
  OPERATORS_MANAGE     @map("operators:manage")

  @@map("platform_permission")
  @@schema("platform_iam")
}

model PlatformOperatorMembership {
  id                    String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  oidcSubject           String                       @unique(map: "operator_memberships_oidc_subject_key") @map("oidc_subject") @db.VarChar(255)
  status                PlatformOperatorStatus       @default(PENDING)
  authorizationRevision BigInt                       @default(1) @map("authorization_revision")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions           PlatformOperatorPermission[]
  requestedProvisioningOperations ProvisioningOperation[] @relation("ProvisioningRequestedBy")
  cancelledProvisioningOperations ProvisioningOperation[] @relation("ProvisioningCancelledBy")
  activationDeliveryIntents ActivationDeliveryIntent[]
  tenantReleasePromotions TenantReleasePromotion[]
  foundationPromotions PlatformFoundationPromotion[]
  requestedProfileOperatorAssignments ProfileOperatorAssignment[] @relation("ProfileOperatorRequestedBy")
  profileOperatorAssignments ProfileOperatorAssignment[] @relation("ProfileOperatorMembership")

  @@index([status, createdAt, id], map: "operator_memberships_status_created_id_idx")
  @@map("operator_memberships")
  @@schema("platform_iam")
}

enum ProfileOperatorAssignmentStatus {
  PENDING @map("pending")
  ACTIVE  @map("active")
  FAILED  @map("failed")

  @@map("profile_operator_assignment_status")
  @@schema("platform_iam")
}

model ProfileOperatorAssignment {
  id                    String                          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId       String                          @map("tenant_profile_id") @db.Uuid
  requestedByOperatorId String                          @map("requested_by_operator_id") @db.Uuid
  operatorId            String?                         @map("operator_id") @db.Uuid
  crmMemberId           String?                         @map("crm_member_id") @db.Uuid
  oidcSubject           String?                         @map("oidc_subject") @db.VarChar(255)
  displayName           String                          @map("display_name") @db.VarChar(160)
  email                 String                          @db.Citext
  status                ProfileOperatorAssignmentStatus @default(PENDING)
  correlationId         String                          @map("correlation_id") @db.VarChar(128)
  idempotencyKey        String                          @map("idempotency_key") @db.VarChar(128)
  leaseOwner            String?                         @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt        DateTime?                       @map("lease_expires_at") @db.Timestamptz(6)
  version               BigInt                          @default(1)
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile         TenantProfile                   @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByOperator   PlatformOperatorMembership      @relation("ProfileOperatorRequestedBy", fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operator              PlatformOperatorMembership?     @relation("ProfileOperatorMembership", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestedByOperatorId, idempotencyKey], map: "profile_operator_assignments_actor_idempotency_key")
  @@unique([tenantProfileId, email], map: "profile_operator_assignments_tenant_email_key")
  @@index([status, leaseExpiresAt, createdAt, id], map: "profile_operator_assignments_claim_idx", where: raw("\"status\" = 'pending'"))
  @@index([tenantProfileId, createdAt, id], map: "profile_operator_assignments_tenant_idx")
  @@index([operatorId], map: "profile_operator_assignments_operator_idx", where: raw("\"operator_id\" IS NOT NULL"))
  @@map("profile_operator_assignments")
  @@schema("platform_iam")
}

model PlatformOperatorPermission {
  operatorId String                     @map("operator_id") @db.Uuid
  permission PlatformPermission
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  operator   PlatformOperatorMembership @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([operatorId, permission], map: "operator_permissions_pkey")
  @@index([permission, operatorId], map: "operator_permissions_permission_operator_idx")
  @@map("operator_permissions")
  @@schema("platform_iam")
}

enum TenantStatus {
  PENDING      @map("pending")
  PROVISIONING @map("provisioning")
  ACTIVE       @map("active")
  SUSPENDED    @map("suspended")
  ERROR        @map("error")
  DECOMMISSIONING @map("decommissioning")
  DELETED      @map("deleted")

  @@map("tenant_status")
  @@schema("tenants")
}

model TenantProfile {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String       @db.Text
  slug              String       @db.Citext
  adminContactName  String       @map("admin_contact_name") @db.Text
  adminContactEmail String       @map("admin_contact_email") @db.Citext
  status            TenantStatus @default(PENDING)
  serverId          String?      @map("server_id") @db.Uuid
  releaseId         String?      @map("release_id") @db.Uuid
  version           BigInt       @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  provisioningOperations ProvisioningOperation[]
  capacityReservations InfrastructureCapacityReservation[]
  database             TenantDatabase?
  storage              TenantStorage?
  configuration        TenantConfiguration?
  container            TenantContainer?
  httpsRoute           TenantHttpsRoute?
  initialAdministrator TenantInitialAdministrator?
  activationDeliveryIntents ActivationDeliveryIntent[]
  tenantReleasePromotions TenantReleasePromotion[]
  decommissioningOperations TenantDecommissioningOperation[]
  profileOperatorAssignments ProfileOperatorAssignment[]
  release           PlatformRelease? @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt, id], map: "tenant_profiles_status_created_id_idx")
  @@index([serverId], map: "tenant_profiles_server_id_idx", where: raw("\"server_id\" IS NOT NULL"))
  @@index([releaseId], map: "tenant_profiles_release_id_idx", where: raw("\"release_id\" IS NOT NULL"))
  @@unique([slug], map: "tenant_profiles_live_slug_uq", where: raw("\"status\" <> 'deleted'"))
  @@map("tenant_profiles")
  @@schema("tenants")
}

enum TenantDecommissioningStatus {
  PENDING @map("pending")
  RUNNING @map("running")
  SUCCEEDED @map("succeeded")
  FAILED @map("failed")

  @@map("tenant_decommissioning_status")
  @@schema("operations")
}

enum TenantDecommissioningStep {
  VALIDATE @map("validate")
  STOP_CONTAINERS @map("stop_containers")
  REMOVE_HTTPS @map("remove_https")
  REMOVE_IDENTITY @map("remove_identity")
  REMOVE_CONFIGURATION @map("remove_configuration")
  REMOVE_STORAGE @map("remove_storage")
  REMOVE_DATABASE @map("remove_database")
  RELEASE_CAPACITY @map("release_capacity")
  TOMBSTONE @map("tombstone")

  @@map("tenant_decommissioning_step")
  @@schema("operations")
}

enum TenantDecommissioningFailureCode {
  TENANT_STATE_INVALID @map("tenant_state_invalid")
  TARGET_CONFLICT @map("target_conflict")
  CONTAINERS_UNAVAILABLE @map("containers_unavailable")
  HTTPS_UNAVAILABLE @map("https_unavailable")
  IDENTITY_UNAVAILABLE @map("identity_unavailable")
  CONFIGURATION_UNAVAILABLE @map("configuration_unavailable")
  STORAGE_UNAVAILABLE @map("storage_unavailable")
  DATABASE_UNAVAILABLE @map("database_unavailable")
  CAPACITY_ACCOUNTING_INVALID @map("capacity_accounting_invalid")
  PERMISSION_DENIED @map("permission_denied")

  @@map("tenant_decommissioning_failure_code")
  @@schema("operations")
}

model TenantDecommissioningOperation {
  id                    String                           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId       String                           @map("tenant_profile_id") @db.Uuid
  requestedByOperatorId String                           @map("requested_by_operator_id") @db.Uuid
  idempotencyKey        String                           @map("idempotency_key") @db.VarChar(128)
  correlationId         String                           @map("correlation_id") @db.VarChar(128)
  confirmationSlug      String                           @map("confirmation_slug") @db.VarChar(63)
  status                TenantDecommissioningStatus     @default(PENDING)
  currentStep           TenantDecommissioningStep       @default(VALIDATE) @map("current_step")
  attempt               Int                              @default(0)
  version               BigInt                           @default(1)
  failureCode           TenantDecommissioningFailureCode? @map("failure_code")
  leaseOwner            String?                          @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt        DateTime?                        @map("lease_expires_at") @db.Timestamptz(6)
  createdAt             DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile         TenantProfile                    @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestedByOperatorId, idempotencyKey], map: "tenant_decommissioning_operations_actor_idempotency_key_uq")
  @@unique([tenantProfileId], map: "tenant_decommissioning_operations_one_open_per_tenant_uq", where: raw("\"status\" IN ('pending', 'running')"))
  @@index([status, leaseExpiresAt, createdAt, id], map: "tenant_decommissioning_operations_claim_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@map("tenant_decommissioning_operations")
  @@schema("operations")
}

enum ActivationDeliveryStatus {
  PENDING   @map("pending")
  CLAIMED   @map("claimed")
  DELIVERED @map("delivered")
  CONSUMED  @map("consumed")
  EXPIRED   @map("expired")
  DISCARDED @map("discarded")

  @@map("activation_delivery_status")
  @@schema("operations")
}

enum PlatformFoundationPromotionStatus {
  PENDING @map("pending")
  RUNNING @map("running")
  SUCCEEDED @map("succeeded")
  FAILED @map("failed")
  @@map("platform_foundation_promotion_status")
  @@schema("operations")
}

enum PlatformFoundationPromotionFailureCode {
  UNAVAILABLE @map("unavailable")
  IDENTITY_MISMATCH @map("identity_mismatch")
  TARGET_CONFLICT @map("target_conflict")
  PERMISSION_DENIED @map("permission_denied")
  @@map("platform_foundation_promotion_failure_code")
  @@schema("operations")
}

enum TenantReleasePromotionStatus {
  PENDING @map("pending")
  RUNNING @map("running")
  SUCCEEDED @map("succeeded")
  FAILED @map("failed")
  @@map("tenant_release_promotion_status")
  @@schema("operations")
}

enum TenantReleasePromotionStep {
  VALIDATE @map("validate")
  MIGRATE @map("migrate")
  RECONCILE @map("reconcile")
  VERIFY @map("verify")
  ACTIVATE @map("activate")
  @@map("tenant_release_promotion_step")
  @@schema("operations")
}

enum TenantReleasePromotionFailureCode {
  TENANT_STATE_INVALID @map("tenant_state_invalid")
  RELEASE_NOT_VALIDATED @map("release_not_validated")
  TARGET_CONFLICT @map("target_conflict")
  MIGRATION_FAILED @map("migration_failed")
  RECONCILIATION_FAILED @map("reconciliation_failed")
  VERIFICATION_FAILED @map("verification_failed")
  PERMISSION_DENIED @map("permission_denied")
  UNAVAILABLE @map("unavailable")
  @@map("tenant_release_promotion_failure_code")
  @@schema("operations")
}

model TenantReleasePromotion {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId String @map("tenant_profile_id") @db.Uuid
  previousReleaseId String @map("previous_release_id") @db.Uuid
  targetReleaseId String @map("target_release_id") @db.Uuid
  requestedByOperatorId String @map("requested_by_operator_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.VarChar(128)
  correlationId String @map("correlation_id") @db.VarChar(128)
  status TenantReleasePromotionStatus @default(PENDING)
  currentStep TenantReleasePromotionStep @default(VALIDATE) @map("current_step")
  attempt Int @default(0)
  version BigInt @default(1)
  failureCode TenantReleasePromotionFailureCode? @map("failure_code")
  leaseOwner String? @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile TenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousRelease PlatformRelease @relation("TenantReleasePromotionPreviousRelease", fields: [previousReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  targetRelease PlatformRelease @relation("TenantReleasePromotionTargetRelease", fields: [targetReleaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByOperator PlatformOperatorMembership @relation(fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([requestedByOperatorId, idempotencyKey], map: "tenant_release_promotions_actor_idempotency_key")
  @@index([status, leaseExpiresAt, createdAt, id], map: "tenant_release_promotions_claim_idx")
  @@map("tenant_release_promotions")
  @@schema("operations")
}

model PlatformFoundationPromotion {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  releaseId String @unique(map: "platform_foundation_promotions_release_id_key") @map("release_id") @db.Uuid
  requestedByOperatorId String @map("requested_by_operator_id") @db.Uuid
  idempotencyKey String @map("idempotency_key") @db.VarChar(128)
  correlationId String @map("correlation_id") @db.VarChar(128)
  status PlatformFoundationPromotionStatus @default(PENDING)
  attempt Int @default(0)
  version BigInt @default(1)
  leaseOwner String? @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  failureCode PlatformFoundationPromotionFailureCode? @map("failure_code")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  release PlatformRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByOperator PlatformOperatorMembership @relation(fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([requestedByOperatorId, idempotencyKey], map: "platform_foundation_promotions_actor_idempotency_key")
  @@index([status, createdAt, id], map: "platform_foundation_promotions_claim_idx")
  @@map("platform_foundation_promotions")
  @@schema("operations")
}

enum TenantInitialAdministratorStatus {
  PENDING @map("pending")
  ACTIVATION_ISSUED @map("activation_issued")
  CONSUMED @map("consumed")
  @@map("tenant_initial_administrator_status")
  @@schema("operations")
}

model TenantInitialAdministrator {
  tenantProfileId String @id @map("tenant_profile_id") @db.Uuid
  keycloakSubject String? @map("keycloak_subject") @db.VarChar(255)
  generation Int @default(0)
  status TenantInitialAdministratorStatus @default(PENDING)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  version BigInt @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile TenantProfile @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@map("tenant_initial_administrators")
  @@schema("tenants")
}

model ActivationDeliveryIntent {
  id                    String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId       String                   @map("tenant_profile_id") @db.Uuid
  requestedByOperatorId String                   @map("requested_by_operator_id") @db.Uuid
  administratorSubject  String                   @map("administrator_subject") @db.VarChar(255)
  generation            Int
  expiresAt             DateTime                 @map("expires_at") @db.Timestamptz(6)
  correlationId         String                   @map("correlation_id") @db.VarChar(128)
  idempotencyKey        String                   @map("idempotency_key") @db.VarChar(128)
  payloadHash           String                   @map("payload_hash") @db.Char(64)
  status                ActivationDeliveryStatus @default(PENDING)
  leaseOwner            String?                  @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt        DateTime?                @map("lease_expires_at") @db.Timestamptz(6)
  resultCode            String?                  @map("result_code") @db.VarChar(64)
  version               BigInt                   @default(1)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
