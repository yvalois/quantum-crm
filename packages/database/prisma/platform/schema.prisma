generator client {
  provider     = "prisma-client"
  output       = "../../generated/platform"
  runtime      = "nodejs"
  moduleFormat = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["infrastructure", "operations", "platform_iam", "tenants"]
}

enum InfrastructureServerStatus {
  AVAILABLE   @map("available")
  DRAINING    @map("draining")
  UNAVAILABLE @map("unavailable")

  @@map("server_status")
  @@schema("infrastructure")
}

enum InfrastructureServerArchitecture {
  X86_64 @map("x86_64")
  ARM64   @map("arm64")

  @@map("server_architecture")
  @@schema("infrastructure")
}

model InfrastructureServer {
  id                     String                           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                   String                           @unique(map: "infrastructure_servers_code_key") @db.Citext
  displayName            String                           @map("display_name") @db.Text
  provider               String                           @db.Text
  region                 String                           @db.Text
  publicIpv4             String                           @unique(map: "infrastructure_servers_public_ipv4_key") @map("public_ipv4") @db.Inet
  operatingSystem        String                           @map("operating_system") @db.Text
  architecture           InfrastructureServerArchitecture
  status                 InfrastructureServerStatus
  totalCpuMillicores     Int                              @map("total_cpu_millicores")
  totalMemoryMib         Int                              @map("total_memory_mib")
  totalStorageMib        Int                              @map("total_storage_mib")
  reservedCpuMillicores  Int                              @default(0) @map("reserved_cpu_millicores")
  reservedMemoryMib      Int                              @default(0) @map("reserved_memory_mib")
  reservedStorageMib     Int                              @default(0) @map("reserved_storage_mib")
  operationCredentialRef String                           @map("operation_credential_ref") @db.VarChar(263)
  confirmedAt            DateTime                         @map("confirmed_at") @db.Timestamptz(6)
  version                BigInt                           @default(1)
  createdAt              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt, id], map: "infrastructure_servers_status_created_id_idx")
  @@map("servers")
  @@schema("infrastructure")
}

enum PlatformOperatorStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("operator_status")
  @@schema("platform_iam")
}

enum PlatformPermission {
  TENANTS_READ         @map("tenants:read")
  TENANTS_MANAGE       @map("tenants:manage")
  CONFIGURATION_READ   @map("configuration:read")
  CONFIGURATION_MANAGE @map("configuration:manage")
  DEPLOYMENTS_READ     @map("deployments:read")
  DEPLOYMENTS_EXECUTE  @map("deployments:execute")
  OPERATORS_MANAGE     @map("operators:manage")

  @@map("platform_permission")
  @@schema("platform_iam")
}

model PlatformOperatorMembership {
  id                    String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  oidcSubject           String                       @unique(map: "operator_memberships_oidc_subject_key") @map("oidc_subject") @db.VarChar(255)
  status                PlatformOperatorStatus       @default(PENDING)
  authorizationRevision BigInt                       @default(1) @map("authorization_revision")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions           PlatformOperatorPermission[]
  provisioningOperations ProvisioningOperation[]

  @@index([status, createdAt, id], map: "operator_memberships_status_created_id_idx")
  @@map("operator_memberships")
  @@schema("platform_iam")
}

model PlatformOperatorPermission {
  operatorId String                     @map("operator_id") @db.Uuid
  permission PlatformPermission
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  operator   PlatformOperatorMembership @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([operatorId, permission], map: "operator_permissions_pkey")
  @@index([permission, operatorId], map: "operator_permissions_permission_operator_idx")
  @@map("operator_permissions")
  @@schema("platform_iam")
}

enum TenantStatus {
  PENDING      @map("pending")
  PROVISIONING @map("provisioning")
  ACTIVE       @map("active")
  SUSPENDED    @map("suspended")
  ERROR        @map("error")

  @@map("tenant_status")
  @@schema("tenants")
}

model TenantProfile {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String       @db.Text
  slug              String       @unique(map: "tenant_profiles_slug_key") @db.Citext
  adminContactName  String       @map("admin_contact_name") @db.Text
  adminContactEmail String       @map("admin_contact_email") @db.Citext
  status            TenantStatus @default(PENDING)
  serverId          String?      @map("server_id") @db.Uuid
  releaseId         String?      @map("release_id") @db.Uuid
  version           BigInt       @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  provisioningOperations ProvisioningOperation[]

  @@index([status, createdAt, id], map: "tenant_profiles_status_created_id_idx")
  @@index([serverId], map: "tenant_profiles_server_id_idx", where: raw("\"server_id\" IS NOT NULL"))
  @@index([releaseId], map: "tenant_profiles_release_id_idx", where: raw("\"release_id\" IS NOT NULL"))
  @@map("tenant_profiles")
  @@schema("tenants")
}

enum ProvisioningOperationStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("provisioning_operation_status")
  @@schema("operations")
}

enum ProvisioningOperationStep {
  VALIDATE             @map("validate")
  CREATE_DATABASE      @map("create_database")
  CREATE_SECRETS       @map("create_secrets")
  CREATE_STORAGE       @map("create_storage")
  WRITE_CONFIGURATION  @map("write_configuration")
  START_CONTAINERS     @map("start_containers")
  CONFIGURE_HTTPS      @map("configure_https")
  CREATE_ADMINISTRATOR @map("create_administrator")
  VERIFY               @map("verify")
  ACTIVATE             @map("activate")

  @@map("provisioning_operation_step")
  @@schema("operations")
}

model ProvisioningOperation {
  id                    String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId       String                      @map("tenant_profile_id") @db.Uuid
  serverId              String                      @map("server_id") @db.Uuid
  releaseId             String                      @map("release_id") @db.Uuid
  requestedByOperatorId String                      @map("requested_by_operator_id") @db.Uuid
  idempotencyKey        String                      @map("idempotency_key") @db.VarChar(128)
  correlationId         String                      @map("correlation_id") @db.VarChar(128)
  status                ProvisioningOperationStatus @default(PENDING)
  currentStep           ProvisioningOperationStep   @default(VALIDATE) @map("current_step")
  attempt               Int                         @default(0)
  version               BigInt                      @default(1)
  leaseOwner            String?                     @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt        DateTime?                   @map("lease_expires_at") @db.Timestamptz(6)
  lastHeartbeatAt       DateTime?                   @map("last_heartbeat_at") @db.Timestamptz(6)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile         TenantProfile               @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByOperator   PlatformOperatorMembership  @relation(fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([requestedByOperatorId, idempotencyKey], map: "provisioning_operations_actor_idempotency_key_key")
  @@index([status, createdAt, id], map: "provisioning_operations_status_created_id_idx")
  @@index([status, leaseExpiresAt, createdAt, id], map: "provisioning_operations_claimable_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@unique([tenantProfileId], map: "provisioning_operations_one_open_per_tenant_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@map("provisioning_operations")
  @@schema("operations")
}
