  id                    String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId       String                      @map("tenant_profile_id") @db.Uuid
  serverId              String                      @map("server_id") @db.Uuid
  releaseId             String                      @map("release_id") @db.Uuid
  capacityReservationId String?                     @map("capacity_reservation_id") @db.Uuid
  requestedCpuMillicores Int?                       @map("requested_cpu_millicores")
  requestedMemoryMib     Int?                       @map("requested_memory_mib")
  requestedStorageMib    Int?                       @map("requested_storage_mib")
  requestedByOperatorId String                      @map("requested_by_operator_id") @db.Uuid
  idempotencyKey        String                      @map("idempotency_key") @db.VarChar(128)
  correlationId         String                      @map("correlation_id") @db.VarChar(128)
  status                ProvisioningOperationStatus @default(PENDING)
  currentStep           ProvisioningOperationStep   @default(VALIDATE) @map("current_step")
  attempt               Int                         @default(0)
  version               BigInt                      @default(1)
  failureCode           ProvisioningValidationFailureCode? @map("failure_code")
  cancelledByOperatorId String?                     @map("cancelled_by_operator_id") @db.Uuid
  cancellationIdempotencyKey String?                @map("cancellation_idempotency_key") @db.VarChar(128)
  cancellationCorrelationId String?                 @map("cancellation_correlation_id") @db.VarChar(128)
  cancellationReason    String?                     @map("cancellation_reason") @db.VarChar(500)
  cancellationExpectedVersion BigInt?               @map("cancellation_expected_version")
  cancellationTenantVersion BigInt?                 @map("cancellation_tenant_version")
  cancellationResult    ProvisioningCancellationResult? @map("cancellation_result")
  cancelledAt           DateTime?                   @map("cancelled_at") @db.Timestamptz(6)
  leaseOwner            String?                     @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt        DateTime?                   @map("lease_expires_at") @db.Timestamptz(6)
  lastHeartbeatAt       DateTime?                   @map("last_heartbeat_at") @db.Timestamptz(6)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile         TenantProfile               @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  server                InfrastructureServer        @relation(fields: [serverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capacityReservation   InfrastructureCapacityReservation? @relation(fields: [capacityReservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByOperator   PlatformOperatorMembership  @relation("ProvisioningRequestedBy", fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cancelledByOperator   PlatformOperatorMembership? @relation("ProvisioningCancelledBy", fields: [cancelledByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release               PlatformRelease              @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stepResults           ProvisioningStepResult[]
  tenantContainer       TenantContainer?
  tenantHttpsRoute      TenantHttpsRoute?

  @@unique([requestedByOperatorId, idempotencyKey], map: "provisioning_operations_actor_idempotency_key_key")
  @@index([status, createdAt, id], map: "provisioning_operations_status_created_id_idx")
  @@unique([capacityReservationId], map: "provisioning_operations_capacity_reservation_id_key")
  @@unique([cancelledByOperatorId, cancellationIdempotencyKey], map: "provisioning_operations_cancellation_idempotency_key_uq", where: raw("\"cancelled_by_operator_id\" IS NOT NULL AND \"cancellation_idempotency_key\" IS NOT NULL"))
  @@index([status, leaseExpiresAt, createdAt, id], map: "provisioning_operations_claimable_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@unique([tenantProfileId], map: "provisioning_operations_one_open_per_tenant_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@map("provisioning_operations")
  @@schema("operations")
}

