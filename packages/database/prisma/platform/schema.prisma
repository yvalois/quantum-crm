generator client {
  provider     = "prisma-client"
  output       = "../../generated/platform"
  runtime      = "nodejs"
  moduleFormat = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["infrastructure", "operations", "platform_iam", "releases", "tenants"]
}

enum PlatformReleaseStatus {
  CANDIDATE @map("candidate")
  VALIDATED @map("validated")
  RETIRED   @map("retired")

  @@map("release_status")
  @@schema("releases")
}

enum PlatformReleaseArtifactName {
  CRM_WEB         @map("crm-web")
  PORTAL_WEB      @map("portal-web")
  ADMIN_WEB       @map("admin-web")
  API             @map("api")
  ADMIN_API       @map("admin-api")
  WORKER          @map("worker")
  DEPLOY_EXECUTOR @map("deploy-executor")
  AGENT_RUNTIME   @map("agent-runtime")

  @@map("release_artifact_name")
  @@schema("releases")
}

model PlatformRelease {
  id                        String                @id @db.Uuid
  semanticVersion           String                @unique(map: "releases_semantic_version_key") @map("semantic_version") @db.VarChar(80)
  commitSha                 String                @unique(map: "releases_commit_sha_key") @map("commit_sha") @db.Char(40)
  status                    PlatformReleaseStatus @default(CANDIDATE)
  releaseNotes              String                @map("release_notes") @db.Text
  configurationSchemaVersion Int                  @map("configuration_schema_version")
  agentContractVersion      String                @map("agent_contract_version") @db.VarChar(80)
  databaseMigrationRequired Boolean               @map("database_migration_required")
  minimumSourceVersion      String?               @map("minimum_source_version") @db.VarChar(80)
  version                   BigInt                @default(1)
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  artifacts                 PlatformReleaseArtifact[]
  tenantProfiles            TenantProfile[]
  capacityReservations      InfrastructureCapacityReservation[]
  provisioningOperations    ProvisioningOperation[]

  @@index([status, createdAt, id], map: "releases_status_created_id_idx")
  @@map("releases")
  @@schema("releases")
}

model PlatformReleaseArtifact {
  releaseId String                      @map("release_id") @db.Uuid
  name      PlatformReleaseArtifactName
  digest    String                      @db.Char(71)
  createdAt DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  release   PlatformRelease             @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([releaseId, name], map: "release_artifacts_pkey")
  @@index([digest], map: "release_artifacts_digest_idx")
  @@map("release_artifacts")
  @@schema("releases")
}

enum InfrastructureServerStatus {
  AVAILABLE   @map("available")
  DRAINING    @map("draining")
  UNAVAILABLE @map("unavailable")

  @@map("server_status")
  @@schema("infrastructure")
}

enum InfrastructureServerArchitecture {
  X86_64 @map("x86_64")
  ARM64   @map("arm64")

  @@map("server_architecture")
  @@schema("infrastructure")
}

model InfrastructureServer {
  id                     String                           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code                   String                           @unique(map: "infrastructure_servers_code_key") @db.Citext
  displayName            String                           @map("display_name") @db.Text
  provider               String                           @db.Text
  region                 String                           @db.Text
  publicIpv4             String                           @unique(map: "infrastructure_servers_public_ipv4_key") @map("public_ipv4") @db.Inet
  operatingSystem        String                           @map("operating_system") @db.Text
  architecture           InfrastructureServerArchitecture
  status                 InfrastructureServerStatus
  totalCpuMillicores     Int                              @map("total_cpu_millicores")
  totalMemoryMib         Int                              @map("total_memory_mib")
  totalStorageMib        Int                              @map("total_storage_mib")
  reservedCpuMillicores  Int                              @default(0) @map("reserved_cpu_millicores")
  reservedMemoryMib      Int                              @default(0) @map("reserved_memory_mib")
  reservedStorageMib     Int                              @default(0) @map("reserved_storage_mib")
  operationCredentialRef String                           @map("operation_credential_ref") @db.VarChar(263)
  confirmedAt            DateTime                         @map("confirmed_at") @db.Timestamptz(6)
  version                BigInt                           @default(1)
  createdAt              DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  capacityReservations   InfrastructureCapacityReservation[]
  provisioningOperations ProvisioningOperation[]

  @@index([status, createdAt, id], map: "infrastructure_servers_status_created_id_idx")
  @@map("servers")
  @@schema("infrastructure")
}

enum InfrastructureCapacityReservationStatus {
  RESERVED @map("reserved")
  ACTIVE   @map("active")
  RELEASED @map("released")

  @@map("capacity_reservation_status")
  @@schema("infrastructure")
}

model InfrastructureCapacityReservation {
  id                 String                                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId    String                                  @map("tenant_profile_id") @db.Uuid
  serverId           String                                  @map("server_id") @db.Uuid
  releaseId          String                                  @map("release_id") @db.Uuid
  status             InfrastructureCapacityReservationStatus @default(RESERVED)
  cpuMillicores      Int                                     @map("cpu_millicores")
  memoryMib          Int                                     @map("memory_mib")
  storageMib         Int                                     @map("storage_mib")
  createdAt          DateTime                                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile      TenantProfile                           @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  server             InfrastructureServer                    @relation(fields: [serverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release            PlatformRelease                         @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provisioningOperations ProvisioningOperation[]

  @@unique([tenantProfileId], map: "capacity_reservations_one_open_per_tenant_idx", where: raw("\"status\" IN ('reserved', 'active')"))
  @@index([serverId, status, createdAt, id], map: "capacity_reservations_server_status_created_id_idx")
  @@map("capacity_reservations")
  @@schema("infrastructure")
}

enum PlatformOperatorStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("operator_status")
  @@schema("platform_iam")
}

enum PlatformPermission {
  TENANTS_READ         @map("tenants:read")
  TENANTS_MANAGE       @map("tenants:manage")
  CONFIGURATION_READ   @map("configuration:read")
  CONFIGURATION_MANAGE @map("configuration:manage")
  DEPLOYMENTS_READ     @map("deployments:read")
  DEPLOYMENTS_EXECUTE  @map("deployments:execute")
  OPERATORS_MANAGE     @map("operators:manage")

  @@map("platform_permission")
  @@schema("platform_iam")
}

model PlatformOperatorMembership {
  id                    String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  oidcSubject           String                       @unique(map: "operator_memberships_oidc_subject_key") @map("oidc_subject") @db.VarChar(255)
  status                PlatformOperatorStatus       @default(PENDING)
  authorizationRevision BigInt                       @default(1) @map("authorization_revision")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions           PlatformOperatorPermission[]
  provisioningOperations ProvisioningOperation[]

  @@index([status, createdAt, id], map: "operator_memberships_status_created_id_idx")
  @@map("operator_memberships")
  @@schema("platform_iam")
}

model PlatformOperatorPermission {
  operatorId String                     @map("operator_id") @db.Uuid
  permission PlatformPermission
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  operator   PlatformOperatorMembership @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([operatorId, permission], map: "operator_permissions_pkey")
  @@index([permission, operatorId], map: "operator_permissions_permission_operator_idx")
  @@map("operator_permissions")
  @@schema("platform_iam")
}

enum TenantStatus {
  PENDING      @map("pending")
  PROVISIONING @map("provisioning")
  ACTIVE       @map("active")
  SUSPENDED    @map("suspended")
  ERROR        @map("error")

  @@map("tenant_status")
  @@schema("tenants")
}

model TenantProfile {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String       @db.Text
  slug              String       @unique(map: "tenant_profiles_slug_key") @db.Citext
  adminContactName  String       @map("admin_contact_name") @db.Text
  adminContactEmail String       @map("admin_contact_email") @db.Citext
  status            TenantStatus @default(PENDING)
  serverId          String?      @map("server_id") @db.Uuid
  releaseId         String?      @map("release_id") @db.Uuid
  version           BigInt       @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  provisioningOperations ProvisioningOperation[]
  capacityReservations InfrastructureCapacityReservation[]
  release           PlatformRelease? @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, createdAt, id], map: "tenant_profiles_status_created_id_idx")
  @@index([serverId], map: "tenant_profiles_server_id_idx", where: raw("\"server_id\" IS NOT NULL"))
  @@index([releaseId], map: "tenant_profiles_release_id_idx", where: raw("\"release_id\" IS NOT NULL"))
  @@map("tenant_profiles")
  @@schema("tenants")
}

enum ProvisioningOperationStatus {
  PENDING   @map("pending")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("provisioning_operation_status")
  @@schema("operations")
}

enum ProvisioningOperationStep {
  VALIDATE             @map("validate")
  CREATE_DATABASE      @map("create_database")
  CREATE_SECRETS       @map("create_secrets")
  CREATE_STORAGE       @map("create_storage")
  WRITE_CONFIGURATION  @map("write_configuration")
  START_CONTAINERS     @map("start_containers")
  CONFIGURE_HTTPS      @map("configure_https")
  CREATE_ADMINISTRATOR @map("create_administrator")
  VERIFY               @map("verify")
  ACTIVATE             @map("activate")

  @@map("provisioning_operation_step")
  @@schema("operations")
}

enum ProvisioningStepOutcome {
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("provisioning_step_outcome")
  @@schema("operations")
}

enum ProvisioningValidationFailureCode {
  TENANT_STATE_INVALID         @map("tenant_state_invalid")
  TENANT_PLACEMENT_MISMATCH    @map("tenant_placement_mismatch")
  SERVER_UNAVAILABLE           @map("server_unavailable")
  RELEASE_NOT_VALIDATED        @map("release_not_validated")
  RESERVATION_INVALID          @map("reservation_invalid")
  CAPACITY_ACCOUNTING_INVALID  @map("capacity_accounting_invalid")

  @@map("provisioning_validation_failure_code")
  @@schema("operations")
}

model ProvisioningOperation {
  id                    String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantProfileId       String                      @map("tenant_profile_id") @db.Uuid
  serverId              String                      @map("server_id") @db.Uuid
  releaseId             String                      @map("release_id") @db.Uuid
  capacityReservationId String?                     @map("capacity_reservation_id") @db.Uuid
  requestedCpuMillicores Int?                       @map("requested_cpu_millicores")
  requestedMemoryMib     Int?                       @map("requested_memory_mib")
  requestedStorageMib    Int?                       @map("requested_storage_mib")
  requestedByOperatorId String                      @map("requested_by_operator_id") @db.Uuid
  idempotencyKey        String                      @map("idempotency_key") @db.VarChar(128)
  correlationId         String                      @map("correlation_id") @db.VarChar(128)
  status                ProvisioningOperationStatus @default(PENDING)
  currentStep           ProvisioningOperationStep   @default(VALIDATE) @map("current_step")
  attempt               Int                         @default(0)
  version               BigInt                      @default(1)
  failureCode           ProvisioningValidationFailureCode? @map("failure_code")
  leaseOwner            String?                     @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt        DateTime?                   @map("lease_expires_at") @db.Timestamptz(6)
  lastHeartbeatAt       DateTime?                   @map("last_heartbeat_at") @db.Timestamptz(6)
  createdAt             DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantProfile         TenantProfile               @relation(fields: [tenantProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  server                InfrastructureServer        @relation(fields: [serverId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  capacityReservation   InfrastructureCapacityReservation? @relation(fields: [capacityReservationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByOperator   PlatformOperatorMembership  @relation(fields: [requestedByOperatorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  release               PlatformRelease              @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  stepResults           ProvisioningStepResult[]

  @@unique([requestedByOperatorId, idempotencyKey], map: "provisioning_operations_actor_idempotency_key_key")
  @@index([status, createdAt, id], map: "provisioning_operations_status_created_id_idx")
  @@unique([capacityReservationId], map: "provisioning_operations_capacity_reservation_id_key")
  @@index([status, leaseExpiresAt, createdAt, id], map: "provisioning_operations_claimable_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@unique([tenantProfileId], map: "provisioning_operations_one_open_per_tenant_idx", where: raw("\"status\" IN ('pending', 'running')"))
  @@map("provisioning_operations")
  @@schema("operations")
}

model ProvisioningStepResult {
  id               String                             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  operationId      String                             @map("operation_id") @db.Uuid
  step             ProvisioningOperationStep
  attempt          Int
  outcome          ProvisioningStepOutcome
  workerId         String                             @map("worker_id") @db.VarChar(128)
  operationVersion BigInt                             @map("operation_version")
  failureCode      ProvisioningValidationFailureCode? @map("failure_code")
  completedAt      DateTime                           @default(now()) @map("completed_at") @db.Timestamptz(6)
  operation        ProvisioningOperation              @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, step, attempt], map: "provisioning_step_results_operation_step_attempt_key")
  @@index([operationId, completedAt, id], map: "provisioning_step_results_operation_completed_id_idx")
  @@map("provisioning_step_results")
  @@schema("operations")
}
