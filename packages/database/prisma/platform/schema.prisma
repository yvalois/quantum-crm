generator client {
  provider     = "prisma-client"
  output       = "../../generated/platform"
  runtime      = "nodejs"
  moduleFormat = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["platform_iam", "tenants"]
}

enum PlatformOperatorStatus {
  PENDING   @map("pending")
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("operator_status")
  @@schema("platform_iam")
}

enum PlatformPermission {
  TENANTS_READ         @map("tenants:read")
  TENANTS_MANAGE       @map("tenants:manage")
  CONFIGURATION_READ   @map("configuration:read")
  CONFIGURATION_MANAGE @map("configuration:manage")
  DEPLOYMENTS_READ     @map("deployments:read")
  DEPLOYMENTS_EXECUTE  @map("deployments:execute")
  OPERATORS_MANAGE     @map("operators:manage")

  @@map("platform_permission")
  @@schema("platform_iam")
}

model PlatformOperatorMembership {
  id                    String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  oidcSubject           String                       @unique(map: "operator_memberships_oidc_subject_key") @map("oidc_subject") @db.VarChar(255)
  status                PlatformOperatorStatus       @default(PENDING)
  authorizationRevision BigInt                       @default(1) @map("authorization_revision")
  createdAt             DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions           PlatformOperatorPermission[]

  @@index([status, createdAt, id], map: "operator_memberships_status_created_id_idx")
  @@map("operator_memberships")
  @@schema("platform_iam")
}

model PlatformOperatorPermission {
  operatorId String                     @map("operator_id") @db.Uuid
  permission PlatformPermission
  createdAt  DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  operator   PlatformOperatorMembership @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([operatorId, permission], map: "operator_permissions_pkey")
  @@index([permission, operatorId], map: "operator_permissions_permission_operator_idx")
  @@map("operator_permissions")
  @@schema("platform_iam")
}

enum TenantStatus {
  PENDING      @map("pending")
  PROVISIONING @map("provisioning")
  ACTIVE       @map("active")
  SUSPENDED    @map("suspended")
  ERROR        @map("error")

  @@map("tenant_status")
  @@schema("tenants")
}

model TenantProfile {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name              String       @db.Text
  slug              String       @unique(map: "tenant_profiles_slug_key") @db.Citext
  adminContactName  String       @map("admin_contact_name") @db.Text
  adminContactEmail String       @map("admin_contact_email") @db.Citext
  status            TenantStatus @default(PENDING)
  serverId          String?      @map("server_id") @db.Uuid
  releaseId         String?      @map("release_id") @db.Uuid
  version           BigInt       @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt, id], map: "tenant_profiles_status_created_id_idx")
  @@index([serverId], map: "tenant_profiles_server_id_idx", where: raw("\"server_id\" IS NOT NULL"))
  @@index([releaseId], map: "tenant_profiles_release_id_idx", where: raw("\"release_id\" IS NOT NULL"))
  @@map("tenant_profiles")
  @@schema("tenants")
}
