{
  "name": "@quantum-crm/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm prisma:platform:generate && pnpm prisma:crm:generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:platform:generate": "prisma generate --schema prisma/platform/schema.prisma",
    "prisma:platform:validate": "prisma validate --schema prisma/platform/schema.prisma",
    "prisma:crm:generate": "prisma generate --schema prisma/crm/schema.prisma",
    "prisma:crm:validate": "prisma validate --schema prisma/crm/schema.prisma",
    "db:check": "pnpm prisma:platform:validate && pnpm prisma:crm:validate && pnpm prisma:platform:generate && pnpm prisma:crm:generate",
    "db:migrate:platform": "prisma migrate deploy --config prisma/platform/prisma7.config.ts",
    "db:migrate:crm": "prisma migrate deploy --config prisma/crm/prisma7.config.ts",
    "db:grant:platform": "node dist/grant-platform-runtime.js",
    "db:provision:platform": "pnpm db:migrate:platform && pnpm db:grant:platform"
  },
  "dependencies": {
    "@quantum-crm/config": "workspace:*",
    "@quantum-crm/domain": "workspace:*",
    "@quantum-crm/platform-domain": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.0"
  }
}
